      "updated": 1761264000000,
      "link": null,
      "locked": false,
      "text": "Invoice posting is one transaction: stock movement + average-cost update + GL journal + audit/outbox + status flip. Cancellation is a reversal, never a delete.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Invoice posting is one transaction: stock movement + average-cost update + GL journal + audit/outbox + status flip. Cancellation is a reversal, never a delete.",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "label-222",

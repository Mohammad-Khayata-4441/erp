      "link": null,
      "locked": false,
      "text": "5 · Domain\n\nService before* hooks enforce\nbusiness rules. Repository\nadds\ntenantId. Presenter maps the\nentity to response DTO.",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-99",
      "originalText": "5 · Domain\n\nService before* hooks enforce\nbusiness rules. Repository\nadds\ntenantId. Presenter maps the\nentity to response DTO.",
      "lineHeight": 1.28,
      "autoResize": false
    },

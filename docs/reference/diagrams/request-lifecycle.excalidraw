      "updated": 1761264000000,
      "link": null,
      "locked": false,
      "text": "4 · Controller\n\nValidationPipe: whitelist +\ntransform. CRUD factory reads\n@CurrentUser().tenantId and\ncalls the service.",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-97",
      "originalText": "4 · Controller\n\nValidationPipe: whitelist +\ntransform. CRUD factory reads\n@CurrentUser().tenantId and\ncalls the service.",
      "lineHeight": 1.28,
      "autoResize": false
    },

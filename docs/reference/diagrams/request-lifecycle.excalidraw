      "link": null,
      "locked": false,
      "text": "1 · Browser\n\nUser clicks Create / Save\nor changes table query.\n\nNo direct API fetch in\nthe feature component.",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-91",
      "originalText": "1 · Browser\n\nUser clicks Create / Save\nor changes table query.\n\nNo direct API fetch in\nthe feature component.",
      "lineHeight": 1.28,
      "autoResize": false
    },

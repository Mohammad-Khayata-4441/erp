      "link": null,
      "locked": false,
      "text": "3 · API edge\n\nJwtAuthGuard validates token.\nPermissionsGuard checks key.\nDomainAvailabilityGuard\nchecks DISABLED_DOMAINS.",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-95",
      "originalText": "3 · API edge\n\nJwtAuthGuard validates token.\nPermissionsGuard checks key.\nDomainAvailabilityGuard\nchecks DISABLED_DOMAINS.",
      "lineHeight": 1.28,
      "autoResize": false
    },

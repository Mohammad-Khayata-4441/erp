      "link": null,
      "locked": false,
      "text": "2 · Next.js\n\nThin route renders a\nclient module component.\nuseApi() resolves the\nApiClient with JWT + locale.",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-93",
      "originalText": "2 · Next.js\n\nThin route renders a\nclient module component.\nuseApi() resolves the\nApiClient with JWT + locale.",
      "lineHeight": 1.28,
      "autoResize": false
    },
